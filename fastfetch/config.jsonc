{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",        // Logo type: auto, builtin, small, file, etc.
    "source": "~/.config/fastfetch/bog-os_icon.txt",
    "padding": {
        "top": 0,
        "left": 0,
        "right": 2
      },
    "color": {
        "1": "#80A639",
      }
    },
  "display": {
    "separator": "",
    "key": {
      "width": 20
    },
    "constants": [
            "\u001b[35C"
        ]
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭─────────────────────────────────────────────────╮"
    },
    {
      "type": "title",
      "key": "│   User      {$1}│",
      "format": "{1}@{2}"
    },
    {
      "type": "custom",
      "format": "├─────────────╮                                   │"
    },
    {
      "type": "os",
      "key": "{#0}│ {#31}󰣇  OS{#0}       │{$1}│",
      "format": "BogOS ({name})"
    },
    {
      "type": "kernel",
      "key": "{#0}│ {#32}  Kernel{#0}   │{$1}│"
    },
    {
      "type": "uptime",
      "key": "{#0}│ {#33}󰥔  Uptime{#0}   │{$1}│"
    },
    {
      "type": "packages",
      "key": "{#0}│ {#34}󰏖  Packages{#0} │{$1}│"
    },
    {
      "type": "shell",
      "key": "{#0}│ {#35}  Shell{#0}    │{$1}│"
    },
    {
      "type": "wm",
      "key": "{#0}│ {#36}  WM{#0}       │{$1}│"
    },
    {
      "type": "terminal",
      "key": "{#0}│ {#37}  Terminal{#0} │{$1}│"
    },
    {
      "type": "cpu",
      "key": "{#0}│ {#31}  CPU{#0}      │{$1}│"
    },
    {
      "type": "gpu",
      "key": "{#0}│ {#32}󰢮  GPU{#0}      │{$1}│"
    },
    {
      "type": "memory",
      "key": "{#0}│ {#33}  Memory{#0}   │{$1}│"
    },
    {
      "type": "battery",
      "key": "{#0}│ {#34}  Battery{#0}  │{$1}│"
    },
    {
      "type": "locale",
      "key": "{#0}│ {#35}󰇧  Locale{#0}   │{$1}│"
    },
    {
      "type": "colors",
      "key": "{#0}│ {#36}  Colors{#0}   │{$1}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "╰─────────────┴───────────────────────────────────╯"
    }
  ]
}
