{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",        // Logo type: auto, builtin, small, file, etc.
    "source": "~/.config/fastfetch/bog-os_icon.txt",
    "padding": {
        "top": 0,
        "left": 0,
        "right": 2
      },
    "color": {
        "1": "#80A639",
      }
    },
  "display": {
    "separator": " │ ",
    "key": {
      "width": 15
    },
    
    },
  "modules": [
    {
      "type": "custom",
      "format": "╭──────────────────────────────────╮"
    },
    {
      "type": "title",
      "format": "│ 󰪫  {user-name}@{host-name}       │"
    },
    {
      "type": "custom",
      "format": "│••••••••••••••••••••••••••••••••••│"
    },
    {
      "type": "os",
      "key": "│ OS",
      // "keyColor": "blue",
      "format": "BogOS ({name})"
    },
    {
      "type": "kernel",
      "keyColor": "blue",
    },
    {
      "type": "uptime",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "keyColor": "blue",
    },
    "shell",
    "wm",
    "theme",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "battery",
    "locale",
    {
      "type": "colors",
      "key": "Colors",
      "symbol": "circle"
    }
  ]
}
